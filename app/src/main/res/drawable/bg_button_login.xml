<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40FFFFFF">
    <item>
        <shape>
            <gradient
                android:angle="0"
                android:endColor="#1A66FF"
                android:startColor="#00CCFF"
                android:type="linear" />
