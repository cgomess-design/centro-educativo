<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Tarjeta en Azul Zafiro Profundo con borde -->
    <item>
        <shape>
            <solid android:color="@color/card_blue" />
            <corners android:radius="24dp" />
            <stroke
                android:width="1.5dp"
                android:color="@color/card_border" />
        </shape>
    </item>

    <!-- Barra de acento superior en Rojo Carmesí -->
    <item
        android:left="24dp"
        android:right="24dp"
        android:top="0dp"
        android:height="3dp">
        <shape>
            <solid android:color="@color/red_primary" />
            <corners android:radius="2dp" />
        </shape>
    </item>
</layer-list>