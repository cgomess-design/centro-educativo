<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Glow exterior en verde esmeralda translúcido -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:centerColor="#3300E676"
                android:endColor="#00000000"
                android:gradientRadius="55dp"
                android:startColor="#6600E676"
                android:type="radial" />
        </shape>
    </item>

    <!-- Círculo interior con borde rojo rubí y relleno azul noche -->
    <item
        android:bottom="8dp"
        android:left="8dp"
        android:right="8dp"
        android:top="8dp">
        <shape android:shape="oval">
            <stroke
                android:width="2dp"
                android:color="#D9E63946" />
            <solid android:color="#4D0B1F38" />
        </shape>
    </item>
</layer-list>