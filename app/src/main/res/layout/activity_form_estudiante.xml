<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="@drawable/bg_surface_card"
        android:elevation="2dp"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Estudiante"
            android:textAppearance="@style/TextAppearance.Centro.ScreenTitle" />

        <EditText
            android:id="@+id/edtCodigoEstudiante"
            style="@style/Widget.Centro.EditText"
            android:layout_width="match_parent"
            android:layout_marginTop="24dp"
            android:hint="Código de estudiante"
            android:inputType="text" />
        <EditText
            android:id="@+id/edtCarnetEstudiante"
            style="@style/Widget.Centro.EditText"
            android:layout_width="match_parent"
            android:layout_marginTop="12dp"
            android:hint="Carnet"
            android:inputType="text" />
        <EditText
            android:id="@+id/edtEmailEstudiante"
            style="@style/Widget.Centro.EditText"
            android:layout_width="match_parent"
            android:layout_marginTop="12dp"
            android:hint="Correo"
            android:inputType="textEmailAddress" />
        <EditText
            android:id="@+id/edtNombreEstudiante"
            style="@style/Widget.Centro.EditText"
            android:layout_width="match_parent"
            android:layout_marginTop="12dp"
            android:hint="Nombre"
            android:inputType="textCapWords" />
        <EditText
            android:id="@+id/edtApellidoEstudiante"
            style="@style/Widget.Centro.EditText"
            android:layout_width="match_parent"
            android:layout_marginTop="12dp"
            android:hint="Apellido"
            android:inputType="textCapWords" />

        <ProgressBar
            android:id="@+id/progressFormEstudiante"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="20dp"
            android:indeterminateTint="@color/primary_blue"
            android:visibility="gone" />
        <Button
            android:id="@+id/btnGuardarEstudiante"
            style="@style/Widget.Centro.PrimaryButton"
            android:layout_width="match_parent"
            android:layout_marginTop="20dp" />
    </LinearLayout>
</ScrollView>
