<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Curso"
            android:textSize="26sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtCodigoCurso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:hint="Código del curso"
            android:inputType="text" />

        <EditText
            android:id="@+id/edtNombreCurso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nombre"
            android:inputType="textCapWords" />

        <EditText
            android:id="@+id/edtCreditosCurso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Créditos"
            android:inputType="number" />

        <EditText
            android:id="@+id/edtDocenteIdCurso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="ID del docente"
            android:inputType="number" />

        <EditText
            android:id="@+id/edtCarreraIdCurso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="ID de la carrera"
            android:inputType="number" />

        <ProgressBar
            android:id="@+id/progressFormCurso"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="20dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnGuardarCurso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp" />

    </LinearLayout>

</ScrollView>



