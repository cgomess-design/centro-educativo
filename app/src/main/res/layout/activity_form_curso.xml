<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="@drawable/bg_surface_card"
        android:elevation="2dp"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Curso"
            android:textAppearance="@style/TextAppearance.Centro.ScreenTitle" />

        <EditText
            android:id="@+id/edtCodigoCurso"
            style="@style/Widget.Centro.EditText"
            android:layout_width="match_parent"
            android:layout_marginTop="24dp"
            android:hint="Código del curso"
            android:inputType="text" />

        <EditText
            android:id="@+id/edtNombreCurso"
            style="@style/Widget.Centro.EditText"
            android:layout_width="match_parent"
            android:layout_marginTop="12dp"
            android:hint="Nombre"
            android:inputType="textCapWords" />

        <EditText
            android:id="@+id/edtCreditosCurso"
            style="@style/Widget.Centro.EditText"
            android:layout_width="match_parent"
            android:layout_marginTop="12dp"
            android:hint="Créditos"
            android:inputType="number" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Docente"
            android:textAppearance="@style/TextAppearance.Centro.Label" />

        <Spinner
            android:id="@+id/spnDocenteCurso"
            style="@style/Widget.Centro.Spinner"
            android:layout_width="match_parent"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Carrera"
            android:textAppearance="@style/TextAppearance.Centro.Label" />

        <Spinner
            android:id="@+id/spnCarreraCurso"
            style="@style/Widget.Centro.Spinner"
            android:layout_width="match_parent"
            android:layout_marginTop="4dp" />

        <ProgressBar
            android:id="@+id/progressFormCurso"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="20dp"
            android:indeterminateTint="@color/primary_blue"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnGuardarCurso"
            style="@style/Widget.Centro.PrimaryButton"
            android:layout_width="match_parent"
            android:layout_marginTop="20dp" />

    </LinearLayout>

</ScrollView>



