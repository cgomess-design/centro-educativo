<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="@drawable/bg_surface_card"
        android:elevation="2dp"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Inscripción"
            android:textAppearance="@style/TextAppearance.Centro.ScreenTitle"
            tools:ignore="HardcodedText" />

        <EditText
            android:id="@+id/edtEstudianteIdInscripcion"
            style="@style/Widget.Centro.EditText"
            android:layout_width="match_parent"
            android:layout_marginTop="24dp"
            android:hint="ID del estudiante"
            android:inputType="number"
            tools:ignore="HardcodedText" />

        <EditText
            android:id="@+id/edtCursoIdInscripcion"
            style="@style/Widget.Centro.EditText"
            android:layout_width="match_parent"
            android:layout_marginTop="12dp"
            android:hint="ID del curso"
            android:inputType="number"
            tools:ignore="HardcodedText" />

        <EditText
            android:id="@+id/edtFechaInscripcion"
            style="@style/Widget.Centro.EditText"
            android:layout_width="match_parent"
            android:layout_marginTop="12dp"
            android:hint="Fecha de inscripción (AAAA-MM-DD)"
            android:inputType="date"
            tools:ignore="HardcodedText" />

        <ProgressBar
            android:id="@+id/progressFormInscripcion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="20dp"
            android:indeterminateTint="@color/primary_blue"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnGuardarInscripcion"
            style="@style/Widget.Centro.PrimaryButton"
            android:layout_width="match_parent"
            android:layout_marginTop="20dp"
            tools:ignore="HardcodedText" />

    </LinearLayout>

</ScrollView>
