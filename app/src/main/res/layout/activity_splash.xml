<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login"
    tools:context=".SplashActivity">

    <!-- Contenedor Central: Logo y Círculo de Carga -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Logo Circular -->
        <FrameLayout
            android:id="@+id/splash_logo_container"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:background="@drawable/bg_logo_circle"
            android:elevation="6dp">

            <ImageView
                android:id="@+id/imgSplashLogo"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:layout_gravity="center"
                android:contentDescription="@string/logo_description"
                android:src="@drawable/ic_centro_educativo_logo" />
        </FrameLayout>

        <!-- Círculo de Progreso -->
        <ProgressBar
            android:id="@+id/progressSplash"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginTop="36dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/text_green_mint" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
