<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Notas"
        android:textAppearance="@style/TextAppearance.Centro.ScreenTitle"
        tools:ignore="HardcodedText" />

    <Button
        android:id="@+id/btnAgregarNota"
        style="@style/Widget.Centro.SecondaryButton"
        android:layout_width="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="12dp"
        android:text="AGREGAR"
        tools:ignore="HardcodedText" />

    <TextView
        android:id="@+id/txtSeleccionarCursoNota"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Seleccione un curso"
        android:textAppearance="@style/TextAppearance.Centro.Label"
        android:visibility="gone"
        tools:ignore="HardcodedText" />

    <Spinner
        android:id="@+id/spnCursoDocenteNota"
        style="@style/Widget.Centro.Spinner"
        android:layout_width="match_parent"
        android:layout_marginTop="4dp"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/progressNotas"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="16dp"
        android:indeterminateTint="@color/primary_blue"
        android:visibility="gone" />

    <TextView
        android:id="@+id/txtNotasVacias"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:background="@drawable/bg_surface_card"
        android:gravity="center"
        android:padding="20dp"
        android:text="No hay notas registradas."
        android:textAppearance="@style/TextAppearance.Centro.Body"
        android:visibility="gone"
        tools:ignore="HardcodedText" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerNotas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        android:layout_weight="1" />

</LinearLayout>
