<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login"
    tools:context=".MainActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="24dp"
            android:paddingTop="28dp"
            android:paddingEnd="24dp"
            android:paddingBottom="36dp">

            <!-- Logo Section -->
            <FrameLayout
                android:id="@+id/menu_logo_container"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_logo_circle"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/imgMenuLogo"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/logo_description"
                    android:src="@drawable/ic_centro_educativo_logo" />
            </FrameLayout>

            <TextView
                android:id="@+id/txtMenuTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="16dp"
                android:fontFamily="sans-serif-bold"
                android:gravity="center"
                android:letterSpacing="0.04"
                android:text="@string/menu_title"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/menu_logo_container" />

            <TextView
                android:id="@+id/txtMenuSubtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="16dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:letterSpacing="0.15"
                android:text="@string/menu_subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/txtMenuTitle" />

            <!-- Indicador Visual del Rol y Usuario -->
            <TextView
                android:id="@+id/txtMenuUserRole"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_role_chip"
                android:fontFamily="sans-serif-bold"
                android:gravity="center"
                android:letterSpacing="0.06"
                android:paddingStart="14dp"
                android:paddingTop="5dp"
                android:paddingEnd="14dp"
                android:paddingBottom="5dp"
                android:textColor="@color/primary_blue"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/txtMenuSubtitle"
                tools:text="ROL: DOCENTE" />

            <!-- Card de Opciones con LinearLayout vertical -->
            <LinearLayout
                android:id="@+id/menu_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:elevation="0dp"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/txtMenuUserRole">

                <!-- Mensaje cuando el usuario no tiene permisos/rol reconocido -->
                <TextView
                    android:id="@+id/txtMenuSinPermisos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:gravity="center"
                    android:text="@string/msg_sin_permisos"
                    android:background="@drawable/bg_surface_card"
                    android:padding="16dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <!-- Opción: Gestionar Estudiantes -->
                <Button
                    android:id="@+id/btnMenuEstudiantes"
                    android:layout_width="match_parent"
                    style="@style/Widget.Centro.MenuButton"
                    android:layout_marginBottom="12dp"
                    android:drawableStart="@drawable/ic_enrollments"
                    android:text="@string/menu_estudiantes"
                    />

                <!-- Opción: Gestionar Docentes -->
                <Button
                    android:id="@+id/btnMenuDocentes"
                    android:layout_width="match_parent"
                    style="@style/Widget.Centro.MenuButton"
                    android:layout_marginBottom="12dp"
                    android:drawableStart="@drawable/ic_user"
                    android:text="@string/menu_docentes"
                    />

                <!-- Opción: Gestionar Cursos -->
                <Button
                    android:id="@+id/btnMenuCursos"
                    android:layout_width="match_parent"
                    style="@style/Widget.Centro.MenuButton"
                    android:layout_marginBottom="12dp"
                    android:drawableStart="@drawable/ic_courses"
                    android:text="@string/menu_cursos"
                    />

                <!-- Opción: Gestionar Inscripciones -->
                <Button
                    android:id="@+id/btnMenuInscripciones"
                    android:layout_width="match_parent"
                    style="@style/Widget.Centro.MenuButton"
                    android:layout_marginBottom="12dp"
                    android:drawableStart="@drawable/ic_enrollments"
                    android:text="@string/menu_inscripciones"
                    />

                <!-- Opción: Gestionar Notas -->
                <Button
                    android:id="@+id/btnMenuNotas"
                    android:layout_width="match_parent"
                    style="@style/Widget.Centro.MenuButton"
                    android:layout_marginBottom="12dp"
                    android:drawableStart="@drawable/ic_notes"
                    android:text="@string/menu_notas"
                    />

                <!-- Opción: Consultar Notas -->
                <Button
                    android:id="@+id/btnMenuConsultarNotas"
                    android:layout_width="match_parent"
                    style="@style/Widget.Centro.MenuButton"
                    android:layout_marginBottom="12dp"
                    android:drawableStart="@drawable/ic_notes"
                    android:text="@string/menu_consultar_notas"
                    />

                <!-- Opción: Consultar Cursos -->
                <Button
                    android:id="@+id/btnMenuConsultarCursos"
                    android:layout_width="match_parent"
                    style="@style/Widget.Centro.MenuButton"
                    android:layout_marginBottom="12dp"
                    android:drawableStart="@drawable/ic_courses"
                    android:text="@string/menu_consultar_cursos"
                    />

                <!-- Opción: Consultar Cursos Asignados -->
                <Button
                    android:id="@+id/btnMenuConsultarCursosAsignados"
                    android:layout_width="match_parent"
                    style="@style/Widget.Centro.MenuButton"
                    android:layout_marginBottom="12dp"
                    android:drawableStart="@drawable/ic_courses"
                    android:text="@string/menu_consultar_cursos_asignados"
                    />

                <!-- Separador -->
                <View
                    android:id="@+id/menu_card_divider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="16dp"
                    android:background="@color/divider_color" />

                <!-- Opción: Cerrar Sesión (Siempre visible) -->
                <Button
                    android:id="@+id/btnMenuCerrarSesion"
                    android:layout_width="match_parent"
                    style="@style/Widget.Centro.DangerButton"
                    android:drawableStart="@drawable/ic_logout"
                    android:gravity="center"
                    android:text="@string/menu_cerrar_sesion"
                    />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
