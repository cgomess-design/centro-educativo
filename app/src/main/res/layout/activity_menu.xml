<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login"
    tools:context=".MainActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="24dp"
            android:paddingTop="36dp"
            android:paddingEnd="24dp"
            android:paddingBottom="36dp">

            <!-- Logo Section -->
            <FrameLayout
                android:id="@+id/menu_logo_container"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="@drawable/bg_logo_circle"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/imgMenuLogo"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/logo_description"
                    android:src="@drawable/ic_centro_educativo_logo" />
            </FrameLayout>

            <TextView
                android:id="@+id/txtMenuTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="16dp"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:letterSpacing="0.04"
                android:text="@string/menu_title"
                android:textColor="@color/white"
                android:textSize="22sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/menu_logo_container" />

            <TextView
                android:id="@+id/txtMenuSubtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="16dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:letterSpacing="0.15"
                android:text="@string/menu_subtitle"
                android:textColor="@color/text_green_mint"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/txtMenuTitle" />

            <!-- Indicador Visual del Rol y Usuario -->
            <TextView
                android:id="@+id/txtMenuUserRole"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_menu_button"
                android:fontFamily="sans-serif-bold"
                android:gravity="center"
                android:letterSpacing="0.06"
                android:paddingStart="14dp"
                android:paddingTop="5dp"
                android:paddingEnd="14dp"
                android:paddingBottom="5dp"
                android:textColor="@color/text_green_mint"
                android:textSize="11sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/txtMenuSubtitle"
                tools:text="ROL: DOCENTE" />

            <!-- Card de Opciones con LinearLayout vertical -->
            <LinearLayout
                android:id="@+id/menu_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_login_card"
                android:elevation="8dp"
                android:orientation="vertical"
                android:padding="20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/txtMenuUserRole">

                <!-- Mensaje cuando el usuario no tiene permisos/rol reconocido -->
                <TextView
                    android:id="@+id/txtMenuSinPermisos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:gravity="center"
                    android:text="@string/msg_sin_permisos"
                    android:textColor="@color/footer_text"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <!-- Opción: Gestionar Estudiantes -->
                <Button
                    android:id="@+id/btnMenuEstudiantes"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_menu_button"
                    android:fontFamily="sans-serif-bold"
                    android:letterSpacing="0.04"
                    android:text="@string/menu_estudiantes"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    app:backgroundTint="@null" />

                <!-- Opción: Gestionar Docentes -->
                <Button
                    android:id="@+id/btnMenuDocentes"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_menu_button"
                    android:fontFamily="sans-serif-bold"
                    android:letterSpacing="0.04"
                    android:text="@string/menu_docentes"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    app:backgroundTint="@null" />

                <!-- Opción: Gestionar Cursos -->
                <Button
                    android:id="@+id/btnMenuCursos"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_menu_button"
                    android:fontFamily="sans-serif-bold"
                    android:letterSpacing="0.04"
                    android:text="@string/menu_cursos"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    app:backgroundTint="@null" />

                <!-- Opción: Gestionar Inscripciones -->
                <Button
                    android:id="@+id/btnMenuInscripciones"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_menu_button"
                    android:fontFamily="sans-serif-bold"
                    android:letterSpacing="0.04"
                    android:text="@string/menu_inscripciones"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    app:backgroundTint="@null" />

                <!-- Opción: Gestionar Notas -->
                <Button
                    android:id="@+id/btnMenuNotas"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_menu_button"
                    android:fontFamily="sans-serif-bold"
                    android:letterSpacing="0.04"
                    android:text="@string/menu_notas"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    app:backgroundTint="@null" />

                <!-- Opción: Consultar Notas -->
                <Button
                    android:id="@+id/btnMenuConsultarNotas"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_menu_button"
                    android:fontFamily="sans-serif-bold"
                    android:letterSpacing="0.04"
                    android:text="@string/menu_consultar_notas"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    app:backgroundTint="@null" />

                <!-- Opción: Consultar Cursos -->
                <Button
                    android:id="@+id/btnMenuConsultarCursos"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_menu_button"
                    android:fontFamily="sans-serif-bold"
                    android:letterSpacing="0.04"
                    android:text="@string/menu_consultar_cursos"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    app:backgroundTint="@null" />

                <!-- Opción: Consultar Cursos Asignados -->
                <Button
                    android:id="@+id/btnMenuConsultarCursosAsignados"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_menu_button"
                    android:fontFamily="sans-serif-bold"
                    android:letterSpacing="0.04"
                    android:text="@string/menu_consultar_cursos_asignados"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    app:backgroundTint="@null" />

                <!-- Separador -->
                <View
                    android:id="@+id/menu_card_divider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="16dp"
                    android:background="@color/divider_color" />

                <!-- Opción: Cerrar Sesión (Siempre visible) -->
                <Button
                    android:id="@+id/btnMenuCerrarSesion"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_button_login"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.05"
                    android:text="@string/menu_cerrar_sesion"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    app:backgroundTint="@null" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
